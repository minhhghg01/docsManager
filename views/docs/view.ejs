<%- include('../partials/header') %>

  <!-- Back link -->
  <div class="mb-4">
    <a href="/docs" class="inline-flex items-center gap-1 text-sm text-slate-500 transition-all hover:text-brand-600">
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
      </svg>
      Quay lại
    </a>
  </div>

  <!-- Document info card -->
  <div class="rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-6 shadow-sm">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div class="min-w-0 flex-1">
        <!-- Badges -->
        <div class="flex flex-wrap items-center gap-2">
          <% if (doc.source_label) { %>
            <span
              class="inline-flex items-center rounded-full bg-brand-600 px-3 py-1 text-xs font-bold uppercase tracking-wider text-white shadow-sm">
              <%= doc.source_label %>
            </span>
            <% } %>
              <% if (doc.is_public) { %>
                <span
                  class="inline-flex items-center rounded-full bg-emerald-500 px-3 py-1 text-xs font-bold text-white shadow-sm">Công
                  khai</span>
                <% } %>
        </div>

        <!-- Title -->
        <h1 class="mt-3 text-2xl font-bold text-slate-800 dark:text-white">
          <%= doc.title %>
        </h1>

        <!-- Filename -->
        <p class="mt-1.5 text-sm text-slate-500 dark:text-slate-400">
          <%= doc.original_filename %>
        </p>

        <!-- Dates -->
        <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-400">
          <span class="inline-flex items-center gap-1.5">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
            </svg>
            Đăng: <%= doc.created_at ? new Date(doc.created_at + 'Z' ).toLocaleString('vi-VN', { day:'2-digit',
              month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' }) : '—' %>
          </span>
          <% if (doc.updated_at && doc.updated_at !==doc.created_at) { %>
            <span class="inline-flex items-center gap-1.5">
              <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round"
                  d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
              Cập nhật: <%= new Date(doc.updated_at + 'Z' ).toLocaleString('vi-VN', { day:'2-digit', month:'2-digit',
                year:'numeric', hour:'2-digit', minute:'2-digit' }) %>
            </span>
            <% } %>
        </div>

        <!-- Tags -->
        <% if (doc.tags && doc.tags.length) { %>
          <div class="mt-3 flex flex-wrap gap-1.5">
            <% doc.tags.forEach(function (t) { %>
              <a href="/docs?tags=<%= encodeURIComponent(t) %>"
                class="rounded-full border border-brand-200 bg-brand-50 px-3 py-0.5 text-xs font-medium text-brand-600 transition-all hover:bg-brand-100">
                <%= t %>
              </a>
              <% }); %>
          </div>
          <% } %>
      </div>

      <!-- Action buttons -->
      <div class="flex shrink-0 gap-2">
        <% if (doc.stored_filename.startsWith('http')) { %>
          <a href="<%= doc.stored_filename %>" target="_blank"
            class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 px-3 py-2 text-sm font-medium text-slate-700 dark:text-slate-200 transition-all hover:bg-slate-100 dark:hover:bg-slate-600 hover:shadow-sm">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            Mở liên kết
          </a>
        <% } else { %>
          <a href="/docs/<%= doc.id %>/download"
            class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 px-3 py-2 text-sm font-medium text-slate-700 dark:text-slate-200 transition-all hover:bg-slate-100 dark:hover:bg-slate-600 hover:shadow-sm">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
            </svg>
            Tải file gốc
          </a>
        <% } %>
        <% if (user && user.role==='admin' ) { %>
          <a href="/admin/documents/<%= doc.id %>/edit"
            class="inline-flex items-center gap-1.5 rounded-lg border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-700 px-3 py-2 text-sm font-medium text-slate-700 dark:text-slate-200 transition-all hover:bg-slate-100 dark:hover:bg-slate-600 hover:shadow-sm">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
            </svg>
            Sửa
          </a>
          <% } %>
      </div>
    </div>
  </div>

  <!-- Tabs for toggling views -->
  <div class="mt-6 flex border-b border-slate-200">
    <button id="tab-full"
      class="w-1/3 py-3 px-2 text-center border-b-2 font-medium text-sm transition-all border-brand-600 text-brand-600 bg-brand-50"
      onclick="switchTab('full')">
      📄 Bản gốc đầy đủ
    </button>
    <button id="tab-summary"
      class="w-1/3 py-3 px-2 text-center border-b-2 border-transparent font-medium text-sm text-slate-500 hover:text-slate-700 hover:border-slate-300 transition-all"
      onclick="switchTab('summary')">
      ✨ Tóm tắt AI
    </button>
    <button id="tab-chat"
      class="w-1/3 py-3 px-2 text-center border-b-2 border-transparent font-medium text-sm text-slate-500 hover:text-slate-700 hover:border-slate-300 transition-all"
      onclick="switchTab('chat')">
      💬 Hỏi đáp AI (Tài liệu này)
    </button>
  </div>

  <!-- ================= AI Summary Section ================= -->
  <div id="view-summary"
    class="hidden mt-5 rounded-2xl border border-indigo-200 dark:border-indigo-900 bg-gradient-to-r from-indigo-50 to-purple-50 dark:from-slate-800 dark:to-slate-900 p-6 shadow-sm">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-2">
        <span class="text-xl">✨</span>
        <h3 class="text-sm font-bold text-indigo-700 dark:text-indigo-400 uppercase tracking-wider">Bản tóm tắt tự động
        </h3>
      </div>
      <div class="flex items-center gap-2" id="summary-actions">
        <% if (doc.ai_summary && user && user.role==='admin' ) { %>
          <button onclick="regenerateSummary(<%= doc.id %>)"
            class="inline-flex items-center gap-1.5 rounded-lg border border-indigo-300 dark:border-indigo-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-medium text-indigo-600 dark:text-indigo-400 transition-all hover:bg-indigo-100 dark:hover:bg-indigo-900 hover:shadow-sm"
            id="btn-regenerate" title="Tạo lại tóm tắt">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round"
                d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182" />
            </svg>
            Tạo lại
          </button>
          <% } %>
      </div>
    </div>

    <div id="summary-content">
      <% if (doc.ai_summary) { %>
        <div
          class="prose prose-sm prose-indigo max-w-none bg-white/60 dark:bg-slate-800/80 p-4 rounded-xl border border-indigo-100/50 dark:border-indigo-800/50">
          <p class="text-sm text-slate-700 dark:text-slate-200 leading-relaxed whitespace-pre-line">
            <%= doc.ai_summary %>
          </p>
        </div>
        <% } else { %>
          <div
            class="text-center py-8 bg-white/50 dark:bg-slate-800/50 rounded-xl border border-indigo-100 dark:border-indigo-800 mb-2">
            <p class="text-sm text-slate-500 dark:text-slate-400 mb-4" id="no-summary-text">
              Chưa có bản tóm tắt tự động cho tài liệu này.
            </p>
            <% if (user && user.role === 'admin') { %>
              <button onclick="generateSummary(<%= doc.id %>)" id="btn-generate-summary"
                class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-4 py-2 text-sm font-medium text-white transition-all hover:bg-indigo-700 hover:shadow-md active:scale-95">
                <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round"
                    d="M9.813 15.904 9 18.75l-.813-2.846a4.5 4.5 0 0 0-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 0 0 3.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 0 0 3.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 0 0-3.09 3.09ZM18.259 8.715 18 9.75l-.259-1.035a3.375 3.375 0 0 0-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 0 0 2.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 0 0 2.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 0 0-2.455 2.456Z" />
                </svg>
                ✨ Kích hoạt AI tóm tắt
              </button>
            <% } %>
          </div>
        <% } %>
    </div>

    <!-- Loading state -->
    <div id="summary-loading" class="hidden">
      <div class="flex items-center justify-center gap-3 py-8">
        <div class="flex gap-1.5">
          <span class="h-2.5 w-2.5 rounded-full bg-indigo-500 animate-bounce" style="animation-delay:0ms"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-indigo-500 animate-bounce" style="animation-delay:150ms"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-indigo-500 animate-bounce" style="animation-delay:300ms"></span>
        </div>
        <span class="text-sm font-medium text-indigo-600 dark:text-indigo-400">Đang phân tích và tóm tắt...</span>
      </div>
    </div>
  </div>

  <!-- ================= Full Document Viewer ================= -->
  <% 
    var iframeSrc = '/docs/' + doc.id + '/view';
    if (typeof highlight !== 'undefined' && highlight) {
      iframeSrc += '?highlight=' + encodeURIComponent(highlight) + '#search=' + encodeURIComponent(highlight);
    }
    var isLink = doc.stored_filename.startsWith('http://') || doc.stored_filename.startsWith('https://');
    if (isLink) {
      var url = doc.stored_filename;
      // YouTube conversion
      var ytMatch = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([^&\s?#]+)/);
      if (ytMatch) {
        iframeSrc = 'https://www.youtube.com/embed/' + ytMatch[1];
      } else {
        // Google Drive conversion
        var gdMatch = url.match(/drive\.google\.com\/file\/d\/([^\/\s?#]+)/);
        if (gdMatch) {
          iframeSrc = 'https://drive.google.com/file/d/' + gdMatch[1] + '/preview';
        }
      }
    }
  %>

  <% if (typeof highlight !== 'undefined' && highlight) { %>
    <div class="mt-4 p-4 bg-gradient-to-r from-amber-50 to-yellow-50 dark:from-amber-950/40 dark:to-yellow-950/30 border-2 border-amber-300 dark:border-amber-700 rounded-2xl shadow-sm transition-all">
      <div class="flex items-start justify-between gap-4">
        <div class="flex items-start gap-3 min-w-0">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-amber-200 dark:bg-amber-900/60 text-amber-900 dark:text-amber-200 text-lg shadow-sm">
            🎯
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <span class="text-xs font-bold uppercase tracking-wider text-amber-800 dark:text-amber-300">Căn cứ trích dẫn câu trả lời từ AI</span>
              <span class="inline-flex items-center rounded-full bg-amber-200/80 dark:bg-amber-900 px-2 py-0.5 text-[10px] font-bold text-amber-900 dark:text-amber-200">Đã định vị bên dưới</span>
            </div>
            <p class="mt-1.5 text-sm font-semibold text-slate-800 dark:text-slate-100 leading-relaxed italic bg-white/80 dark:bg-slate-800/80 p-3 rounded-xl border border-amber-200/70 dark:border-amber-800/50 shadow-inner">
              "<%= highlight %>"
            </p>
          </div>
        </div>
        <a href="/docs/<%= doc.id %>" class="shrink-0 inline-flex items-center gap-1 rounded-xl bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 px-3 py-1.5 text-xs font-semibold text-slate-600 dark:text-slate-300 hover:text-rose-600 hover:border-rose-300 dark:hover:text-rose-400 shadow-sm transition-all" title="Bỏ tô sáng">
          <span>Bỏ tô sáng</span>
          <span>✕</span>
        </a>
      </div>
    </div>
  <% } %>

  <div id="view-full"
    class="block mt-5 overflow-hidden rounded-2xl border border-slate-200 dark:border-slate-700 bg-slate-100 dark:bg-slate-900 shadow-inner">
    <% if (isLink) { %>
      <div class="bg-white dark:bg-slate-800 p-8 text-center flex flex-col items-center justify-center border-b border-slate-200 dark:border-slate-700">
        <div class="h-16 w-16 bg-blue-50 dark:bg-blue-950/30 text-blue-600 dark:text-blue-400 rounded-full flex items-center justify-center mb-4">
          <svg class="h-8 w-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </div>
        <h3 class="text-lg font-bold text-slate-800 dark:text-white mb-2">Tài liệu này được lưu trữ dưới dạng liên kết ngoài</h3>
        <p class="text-sm text-slate-500 dark:text-slate-400 max-w-md mb-4 truncate w-full"><%= doc.stored_filename %></p>
        
        <a href="<%= doc.stored_filename %>" target="_blank" class="inline-flex items-center gap-2 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-semibold px-6 py-3 shadow-md hover:shadow-lg transition-all active:scale-95">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
          Mở liên kết trong tab mới
        </a>

        <!-- Hướng dẫn thân thiện -->
        <div class="mt-5 p-3.5 bg-amber-50 dark:bg-amber-950/20 border border-amber-200 dark:border-amber-900/50 rounded-xl max-w-lg text-left">
          <p class="text-xs text-amber-700 dark:text-amber-400 flex items-start gap-2 font-medium">
            <svg class="h-5 w-5 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
            <span><strong>Lưu ý bảo mật:</strong> Các trang web lớn như Facebook, Google, YouTube,... chặn không cho phép nhúng trực tiếp vào các trang web khác (iframe). Nếu ô hiển thị bên dưới báo lỗi, bạn chỉ cần nhấn vào nút <strong>Mở liên kết trong tab mới</strong> ở trên để truy cập.</span>
          </p>
        </div>
      </div>
    <% } %>
    <iframe title="Xem tài liệu" src="<%= iframeSrc %>"
      class="h-[95vh] w-full bg-white border-0 filter dark:invert"></iframe>
  </div>

  <!-- ================= AI Document Chat (NotebookLM) ================= -->
  <div id="view-chat"
    class="hidden mt-5 rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 shadow-sm flex flex-col overflow-hidden"
    style="height: 80vh;">
    <!-- Header -->
    <div
      class="flex items-center justify-between bg-slate-50 dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 px-5 py-3">
      <div class="flex items-center gap-3">
        <div class="flex h-9 w-9 items-center justify-center rounded-full bg-indigo-100 text-indigo-600">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M12 20.25c4.97 0 9-3.694 9-8.25s-4.03-8.25-9-8.25S3 7.444 3 12c0 2.104.859 4.023 2.273 5.48.432.447.74 1.04.586 1.641a4.483 4.483 0 0 1-.923 1.785A5.969 5.969 0 0 0 6 21c1.282 0 2.47-.402 3.445-1.087.81.22 1.668.337 2.555.337Z" />
          </svg>
        </div>
        <div>
          <h3 class="text-sm font-bold text-slate-800 dark:text-slate-100">AI Hỏi đáp</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400">Hỏi đáp trực tiếp nội dung trong tài liệu này</p>
        </div>
      </div>
      <button onclick="clearDocChatHistory()" class="inline-flex items-center gap-1 text-xs text-slate-500 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/30 px-2 py-1 rounded transition-colors" title="Xóa lịch sử hội thoại tài liệu này trong phiên">
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" /></svg>
        Xóa lịch sử
      </button>
    </div>

    <!-- Messages -->
    <div id="doc-chat-messages" class="flex-1 overflow-y-auto p-4 space-y-4 bg-slate-50/50 dark:bg-slate-900/50">
      <div class="flex gap-3">
        <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-indigo-100">
          <span class="text-sm">🤖</span>
        </div>
        <div class="rounded-2xl rounded-tl-sm bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm px-4 py-3 text-sm text-slate-700 dark:text-slate-200 max-w-[85%] relative">
          <p class="mb-2">Xin chào! Tôi có thể đọc và trả lời bất kỳ thông tin nào liên quan đến tài liệu <strong>"<%= doc.title %>"</strong>. Bạn muốn hỏi gì?</p>
          <button id="btn-tts-welcome" data-text="Xin chào! Tôi có thể đọc và trả lời bất kỳ thông tin nào liên quan đến tài liệu." onclick="speakText(this.dataset.text, this.id)" class="inline-flex items-center gap-1 text-xs font-medium text-brand-600 bg-brand-50 hover:bg-brand-100 dark:bg-slate-700 dark:text-brand-400 dark:hover:bg-slate-600 px-2 py-1 rounded transition-colors" title="Đọc văn bản">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 0 1 0 12.728M16.463 8.288a5.25 5.25 0 0 1 0 7.424M6.75 8.25l4.72-4.72a.75.75 0 0 1 1.28.53v15.88a.75.75 0 0 1-1.28.53l-4.72-4.72H4.51c-.88 0-1.5-.62-1.5-1.5v-4.5c0-.88.62-1.5 1.5-1.5h2.24Z"/></svg>
            Nghe đáp án
          </button>
        </div>
      </div>
    </div>

    <!-- Input -->
    <div class="border-t border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-4">
      <form onsubmit="sendDocChat(event)" class="flex gap-2">
        <input type="text" id="doc-chat-input" placeholder="Hỏi về tài liệu này..." autocomplete="off"
          class="flex-1 rounded-xl border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-900 px-4 py-3 text-sm text-slate-700 dark:text-slate-200 placeholder-slate-400 dark:placeholder-slate-500 transition-all focus:bg-white dark:focus:bg-slate-800 focus:border-indigo-400 focus:outline-none focus:ring-2 focus:ring-indigo-100" />
        <button type="submit" id="doc-chat-send"
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-indigo-600 text-white transition-all hover:bg-indigo-700 active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round"
              d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
          </svg>
        </button>
      </form>
    </div>
  </div>

  <!-- ================= Document Comments Section ================= -->
  <div class="mt-8 rounded-2xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-6 shadow-sm" id="comments-section">
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-700/60 pb-4 mb-6">
      <div class="flex items-center gap-2.5">
        <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand-50 dark:bg-brand-950/50 text-brand-600 dark:text-brand-400">
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.502 49.188 49.188 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v4.77Z" />
          </svg>
        </div>
        <div>
          <h2 class="text-base font-bold text-slate-800 dark:text-slate-100">Bình luận & Thảo luận</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400"><span id="comments-count-title"><%= (typeof comments !== 'undefined' ? comments.length : 0) %></span> bình luận cho tài liệu này</p>
        </div>
      </div>
      <span id="comments-count-badge" class="rounded-full bg-slate-100 dark:bg-slate-700 px-3 py-1 text-xs font-semibold text-slate-600 dark:text-slate-300">
        <%= (typeof comments !== 'undefined' ? comments.length : 0) %>
      </span>
    </div>

    <!-- Comment Form or Login Notice -->
    <% if (user) { %>
      <form id="comment-form" onsubmit="submitComment(event)" class="mb-8">
        <div class="flex gap-3">
          <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-brand-600 font-bold text-white text-sm shadow-sm">
            <%= (user.full_name || user.username).charAt(0).toUpperCase() %>
          </div>
          <div class="flex-1">
            <div class="relative rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 focus-within:border-brand-500 focus-within:bg-white dark:focus-within:bg-slate-800 focus-within:ring-2 focus-within:ring-brand-100 dark:focus-within:ring-brand-900/30 transition-all">
              <textarea id="comment-input" name="content" rows="3" required placeholder="Viết ý kiến hoặc ghi chú của bạn về tài liệu này..." class="w-full resize-none bg-transparent px-4 py-3 text-sm text-slate-800 dark:text-slate-100 placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none"></textarea>
              <div class="flex flex-wrap items-center justify-between gap-2 border-t border-slate-100 dark:border-slate-800 px-3 py-2 bg-slate-50/50 dark:bg-slate-900/50 rounded-b-xl">
                <span class="text-xs text-slate-400">
                  Nhấn <kbd class="px-1.5 py-0.5 text-[10px] font-semibold bg-slate-200 dark:bg-slate-700 rounded border border-slate-300 dark:border-slate-600">Enter</kbd> để gửi, <kbd class="px-1.5 py-0.5 text-[10px] font-semibold bg-slate-200 dark:bg-slate-700 rounded border border-slate-300 dark:border-slate-600">Shift+Enter</kbd> để xuống dòng
                </span>
                <button type="submit" id="comment-submit-btn" class="inline-flex items-center gap-1.5 rounded-lg bg-brand-600 hover:bg-brand-700 px-4 py-1.5 text-xs font-semibold text-white shadow-sm transition-all active:scale-95 disabled:opacity-50">
                  <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 12 3.269 3.125A59.769 59.769 0 0 1 21.485 12 59.768 59.768 0 0 1 3.27 20.875L5.999 12Zm0 0h7.5" />
                  </svg>
                  Gửi bình luận
                </button>
              </div>
            </div>
          </div>
        </div>
      </form>
    <% } else { %>
      <div class="mb-8 p-4 rounded-xl border border-dashed border-slate-300 dark:border-slate-700 bg-slate-50/80 dark:bg-slate-900/50 text-center flex flex-col sm:flex-row items-center justify-between gap-3">
        <div class="flex items-center gap-3 text-left">
          <span class="text-2xl">🔒</span>
          <div>
            <p class="text-sm font-semibold text-slate-700 dark:text-slate-200">Bạn cần đăng nhập để tham gia bình luận</p>
            <p class="text-xs text-slate-500 dark:text-slate-400">Khách chỉ có thể đọc nội dung bình luận đã có.</p>
          </div>
        </div>
        <a href="/login?next=<%= encodeURIComponent('/docs/' + doc.id + '#comments-section') %>" class="inline-flex items-center gap-1.5 rounded-lg bg-brand-600 hover:bg-brand-700 px-4 py-2 text-xs font-semibold text-white shadow-sm transition-all active:scale-95 shrink-0">
          Đăng nhập ngay
        </a>
      </div>
    <% } %>

    <!-- Comments List -->
    <% if (typeof comments === 'undefined' || comments.length === 0) { %>
      <div id="no-comments-placeholder" class="py-10 text-center text-slate-400 dark:text-slate-500">
        <svg class="h-10 w-10 mx-auto mb-2 text-slate-300 dark:text-slate-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 21c-.496 0-.89-.408-.89-.91 0-.16.036-.316.104-.457A5.98 5.98 0 0 0 6 16.5c0-.62-.128-1.21-.36-1.748C4.545 13.57 4 12.02 4 10.375 4 5.75 8.03 2 13 2s9 3.75 9 8.375Z" />
        </svg>
        <p class="text-sm">Chưa có bình luận nào cho tài liệu này.</p>
        <p class="text-xs text-slate-400 mt-0.5">Hãy là người đầu tiên để lại ý kiến!</p>
      </div>
      <div id="comments-list-container" class="space-y-4"></div>
    <% } else { %>
      <div id="comments-list-container" class="space-y-4">
        <% comments.forEach(c => { %>
          <div id="comment-item-<%= c.id %>" class="flex gap-3.5 p-4 rounded-xl border border-slate-100 dark:border-slate-700/60 bg-slate-50/50 dark:bg-slate-900/40 hover:bg-slate-50 dark:hover:bg-slate-900/70 transition-colors group">
            <!-- Avatar -->
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-tr from-brand-500 to-indigo-600 text-white font-bold text-xs shadow-sm">
              <%= (c.full_name || c.username).charAt(0).toUpperCase() %>
            </div>
            <!-- Content -->
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-sm font-semibold text-slate-800 dark:text-slate-100">
                    <%= c.full_name || c.username %>
                  </span>
                  <% if (c.role === 'admin') { %>
                    <span class="rounded bg-rose-100 dark:bg-rose-950/60 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-rose-600 dark:text-rose-400">Quản trị viên</span>
                  <% } %>
                  <% if (c.department_name || c.khoa_name) { %>
                    <span class="rounded bg-slate-200/80 dark:bg-slate-800 px-1.5 py-0.5 text-[10px] font-medium text-slate-600 dark:text-slate-300"><%= c.department_name || c.khoa_name %></span>
                  <% } %>
                  <span class="text-xs text-slate-400">
                    • <%= c.created_at ? new Date(c.created_at + 'Z').toLocaleString('vi-VN', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' }) : '' %>
                  </span>
                </div>
                <!-- Delete action if authorized -->
                <% if (user && (user.role === 'admin' || user.id === c.user_id)) { %>
                  <button type="button" onclick="deleteComment(<%= c.id %>)" class="opacity-0 group-hover:opacity-100 transition-opacity p-1 rounded text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/30" title="Xóa bình luận">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                    </svg>
                  </button>
                <% } %>
              </div>
              <p class="mt-1.5 text-sm text-slate-700 dark:text-slate-300 whitespace-pre-line leading-relaxed"><%= c.content %></p>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>


    <script>
      function formatDocAiAnswer(text) {
        if (!text) return '';
        let html = escapeHtml(text);
        html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
        html = html.replace(/\*(.*?)\*/g, '<em>$1</em>');
        html = html.replace(/`([^`]+)`/g, '<code class="bg-slate-100 dark:bg-slate-700 px-1 py-0.5 rounded text-xs">$1</code>');
        html = html.replace(/(?:^|<br>)[-*]\s+(.*?)(?=(?:<br>|$))/g, '<br>• $1');
        html = html.replace(/(?:^|<br>)(\d+)\.\s+(.*?)(?=(?:<br>|$))/g, '<br><b>$1.</b> $2');
        html = html.replace(/\n/g, '<br>');
        return html;
      }

      async function generateSummary(docId) {
        const contentEl = document.getElementById('summary-content');
        const loadingEl = document.getElementById('summary-loading');
        const actionsEl = document.getElementById('summary-actions');

        contentEl.classList.add('hidden');
        loadingEl.classList.remove('hidden');

        try {
          const resp = await fetch('/api/ai/summarize/' + docId, { method: 'POST' });
          const data = await resp.json();

          if (!resp.ok) {
            throw new Error(data.error || 'Lỗi không xác định');
          }

          loadingEl.classList.add('hidden');
          contentEl.classList.remove('hidden');
          contentEl.innerHTML = '<div class="prose prose-sm prose-indigo max-w-none bg-white/60 dark:bg-slate-800/80 p-4 rounded-xl border border-indigo-100/50 dark:border-indigo-800/50 leading-relaxed text-slate-700 dark:text-slate-200">' + formatDocAiAnswer(data.summary) + '</div>';

          actionsEl.innerHTML = `
      <button onclick="regenerateSummary(${docId})"
        class="inline-flex items-center gap-1 rounded-lg border border-indigo-300 dark:border-indigo-700 bg-white dark:bg-slate-800 px-3 py-1.5 text-xs font-medium text-indigo-600 dark:text-indigo-400 transition-all hover:bg-indigo-100 dark:hover:bg-indigo-900 hover:shadow-sm"
        title="Tạo lại tóm tắt">
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182"/></svg>
        Tạo lại
      </button>`;
        } catch (err) {
          loadingEl.classList.add('hidden');
          contentEl.classList.remove('hidden');
          contentEl.innerHTML = '<p class="text-sm text-red-500">⚠️ ' + escapeHtml(err.message) + '</p>';
        }
      }

      async function regenerateSummary(docId) {
        // Xóa cache trước
        await fetch('/api/ai/summarize/' + docId, { method: 'DELETE' });
        // Tạo lại
        generateSummary(docId);
      }

      function escapeHtml(str) {
        const d = document.createElement('div');
        d.textContent = str;
        return d.innerHTML;
      }

      function switchTab(tab) {
        const btnFull = document.getElementById('tab-full');
        const btnSummary = document.getElementById('tab-summary');
        const btnChat = document.getElementById('tab-chat');
        const viewFull = document.getElementById('view-full');
        const viewSummary = document.getElementById('view-summary');
        const viewChat = document.getElementById('view-chat');

        // Xóa mọi active + hiển thị trước
        viewFull.classList.remove('block'); viewFull.classList.add('hidden');
        viewSummary.classList.remove('block'); viewSummary.classList.add('hidden');
        viewChat.classList.remove('block', 'flex'); viewChat.classList.add('hidden');

        btnFull.className = "w-1/3 py-3 px-2 text-center border-b-2 border-transparent font-medium text-sm text-slate-500 hover:text-slate-700 hover:border-slate-300 transition-all";
        btnSummary.className = "w-1/3 py-3 px-2 text-center border-b-2 border-transparent font-medium text-sm text-slate-500 hover:text-slate-700 hover:border-slate-300 transition-all";
        btnChat.className = "w-1/3 py-3 px-2 text-center border-b-2 border-transparent font-medium text-sm text-slate-500 hover:text-slate-700 hover:border-slate-300 transition-all";

        if (tab === 'full') {
          viewFull.classList.remove('hidden'); viewFull.classList.add('block');
          btnFull.className = "w-1/3 py-3 px-2 text-center border-b-2 font-medium text-sm transition-all border-brand-600 text-brand-600 bg-brand-50";
        } else if (tab === 'summary') {
          viewSummary.classList.remove('hidden'); viewSummary.classList.add('block');
          btnSummary.className = "w-1/3 py-3 px-2 text-center border-b-2 font-medium text-sm transition-all border-indigo-500 text-indigo-600 bg-indigo-50";
        } else if (tab === 'chat') {
          viewChat.classList.remove('hidden'); viewChat.classList.add('flex');
          btnChat.className = "w-1/3 py-3 px-2 text-center border-b-2 font-medium text-sm transition-all border-pink-500 text-pink-600 bg-pink-50";
        }
      }

        // --- Logic Chat trực tiếp vào tài liệu này (NotebookLM với Session History) ---
        const DOC_CHAT_KEY = 'docs_chat_doc_' + <%= doc.id %>;

        function getDocChatHistory() {
          try {
            const raw = sessionStorage.getItem(DOC_CHAT_KEY);
            return raw ? JSON.parse(raw) : [];
          } catch(e) {
            return [];
          }
        }

        function saveDocChatMessage(msg) {
          try {
            const list = getDocChatHistory();
            list.push(msg);
            if (list.length > 50) list.shift();
            sessionStorage.setItem(DOC_CHAT_KEY, JSON.stringify(list));
          } catch(e) {}
        }

        function clearDocChatHistory() {
          if (confirm('Bạn có muốn xóa toàn bộ lịch sử hỏi đáp AI về tài liệu này trong phiên hiện tại?')) {
            sessionStorage.removeItem(DOC_CHAT_KEY);
            const container = document.getElementById('doc-chat-messages');
            container.innerHTML = `
              <div class="flex gap-3">
                <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-indigo-100">
                  <span class="text-sm">🤖</span>
                </div>
                <div class="rounded-2xl rounded-tl-sm bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm px-4 py-3 text-sm text-slate-700 dark:text-slate-200 max-w-[85%] relative">
                  <p class="mb-2">Xin chào! Tôi có thể đọc và trả lời bất kỳ thông tin nào liên quan đến tài liệu <strong>"<%= doc.title %>"</strong>. Bạn muốn hỏi gì?</p>
                  <button id="btn-tts-welcome" data-text="Xin chào! Tôi có thể đọc và trả lời bất kỳ thông tin nào liên quan đến tài liệu." onclick="speakText(this.dataset.text, this.id)" class="inline-flex items-center gap-1 text-xs font-medium text-brand-600 bg-brand-50 hover:bg-brand-100 dark:bg-slate-700 dark:text-brand-400 dark:hover:bg-slate-600 px-2 py-1 rounded transition-colors" title="Đọc văn bản">
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 0 1 0 12.728M16.463 8.288a5.25 5.25 0 0 1 0 7.424M6.75 8.25l4.72-4.72a.75.75 0 0 1 1.28.53v15.88a.75.75 0 0 1-1.28.53l-4.72-4.72H4.51c-.88 0-1.5-.62-1.5-1.5v-4.5c0-.88.62-1.5 1.5-1.5h2.24Z"/></svg>
                    Nghe đáp án
                  </button>
                </div>
              </div>`;
          }
        }

        window.jumpToDocHighlight = function(quote) {
          if (!quote) return;
          const iframe = document.querySelector('iframe');
          if (iframe) {
            iframe.src = '/docs/<%= doc.id %>/view?highlight=' + encodeURIComponent(quote) + '#search=' + encodeURIComponent(quote);
            iframe.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } else {
            window.location.href = '/docs/<%= doc.id %>?highlight=' + encodeURIComponent(quote);
          }
        };

        function appendDocChatMessage(role, content, saveToStorage = true, sources = null) {
          const container = document.getElementById('doc-chat-messages');
          if (!container) return;

          const msgDiv = document.createElement('div');
          if (role === 'user') {
            msgDiv.className = 'flex justify-end gap-3 ai-msg-animate';
            msgDiv.innerHTML = `<div class="rounded-2xl rounded-tr-sm bg-indigo-600 px-4 py-3 text-sm text-white shadow-sm max-w-[85%]">${escapeHtml(content)}</div>`;
          } else {
            msgDiv.className = 'flex gap-3 ai-msg-animate';
            const formatted = formatDocAiAnswer(content);
            const cleanAnswer = content.replace(/"/g, '&quot;');
            const btnId = 'btn-tts-' + Date.now() + Math.floor(Math.random() * 1000);

            let highlightBtn = '';
            const highlight = sources && sources[0] && sources[0].highlight;
            if (highlight) {
              const cleanHighlight = highlight.replace(/'/g, "\\'").replace(/"/g, '&quot;');
              highlightBtn = `
                <button onclick="jumpToDocHighlight('${cleanHighlight}')" class="inline-flex items-center gap-1 text-xs font-semibold text-amber-700 bg-amber-50 hover:bg-amber-100 border border-amber-200 dark:bg-amber-950/40 dark:text-amber-300 dark:border-amber-800 px-2 py-1 rounded transition-colors shadow-sm" title="Nhảy tới vị trí câu này trong văn bản">
                  🎯 Vị trí trong văn bản
                </button>`;
            }

            msgDiv.innerHTML = `
              <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-indigo-100">
                <span class="text-sm">🤖</span>
              </div>
              <div class="rounded-2xl rounded-tl-sm bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm px-4 py-3 text-sm text-slate-700 dark:text-slate-200 max-w-[85%] leading-relaxed relative">
                <div class="mb-2">${formatted}</div>
                <div class="flex flex-wrap items-center gap-2 mt-2">
                  <button id="${btnId}" data-text="${cleanAnswer}" onclick="speakText(this.dataset.text, this.id)" class="inline-flex items-center gap-1 text-xs font-medium text-brand-600 bg-brand-50 hover:bg-brand-100 dark:bg-slate-700 dark:text-brand-400 dark:hover:bg-slate-600 px-2 py-1 rounded transition-colors" title="Đọc toàn bộ câu trả lời">
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 0 1 0 12.728M16.463 8.288a5.25 5.25 0 0 1 0 7.424M6.75 8.25l4.72-4.72a.75.75 0 0 1 1.28.53v15.88a.75.75 0 0 1-1.28.53l-4.72-4.72H4.51c-.88 0-1.5-.62-1.5-1.5v-4.5c0-.88.62-1.5 1.5-1.5h2.24Z"/></svg>
                    Nghe đáp án
                  </button>
                  ${highlightBtn}
                </div>
              </div>`;
          }

          container.appendChild(msgDiv);
          container.scrollTop = container.scrollHeight;

          if (saveToStorage) {
            saveDocChatMessage({ role, content, sources });
          }
        }

        async function sendDocChat(e) {
          e.preventDefault();
          const input = document.getElementById('doc-chat-input');
          const sendBtn = document.getElementById('doc-chat-send');
          const container = document.getElementById('doc-chat-messages');
          const question = input.value.trim();
          if (!question) return;

          // Thêm và lưu tin nhắn của người dùng
          appendDocChatMessage('user', question, true);

          input.value = '';
          input.disabled = true;
          sendBtn.disabled = true;

          // Add thinking dot
          const thinkingId = 'doc-thinking-' + Date.now();
          const thinkingWait = document.createElement('div');
          thinkingWait.id = thinkingId;
          thinkingWait.className = 'flex gap-3 ai-msg-animate';
          thinkingWait.innerHTML = `
            <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-indigo-100">
              <span class="text-sm">🤖</span>
            </div>
            <div class="rounded-2xl rounded-tl-sm bg-white border border-slate-200 shadow-sm px-4 py-3 flex items-center gap-1.5">
              <span class="h-2 w-2 rounded-full bg-indigo-400 animate-bounce" style="animation-delay:0ms"></span>
              <span class="h-2 w-2 rounded-full bg-indigo-400 animate-bounce" style="animation-delay:150ms"></span>
              <span class="h-2 w-2 rounded-full bg-indigo-400 animate-bounce" style="animation-delay:300ms"></span>
            </div>`;
          container.appendChild(thinkingWait);
          container.scrollTop = container.scrollHeight;

          try {
            const docId = <%= doc.id %>;
            const resp = await fetch('/api/ai/chat', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ question, docId })
            });
            const data = await resp.json();
            document.getElementById(thinkingId)?.remove();

            if (!resp.ok) {
              const errText = '⚠️ Lỗi: ' + (data.error || 'Không xác định');
              appendDocChatMessage('ai', errText, true);
            } else {
              appendDocChatMessage('ai', data.answer, true, data.sources);
              // Tự động định vị và tô sáng đoạn trích dẫn trong văn bản
              if (data.sources && data.sources[0] && data.sources[0].highlight) {
                jumpToDocHighlight(data.sources[0].highlight);
              }
            }
          } catch (err) {
            document.getElementById(thinkingId)?.remove();
            appendDocChatMessage('ai', '⚠️ Lỗi mạng: ' + err.message, true);
          }

          input.disabled = false;
          sendBtn.disabled = false;
          input.focus();
        }

        function initDocChatHistory() {
          const history = getDocChatHistory();
          if (history && history.length > 0) {
            history.forEach(item => {
              appendDocChatMessage(item.role, item.content, false, item.sources);
            });
          }
        }

        // --- Xử lý sự kiện gõ Enter gửi bình luận, Shift+Enter xuống dòng ---
        const commentInput = document.getElementById('comment-input');
        if (commentInput) {
          commentInput.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
              if (e.shiftKey) {
                // Chỉ cho phép Shift+Enter để xuống dòng
                return;
              }
              e.preventDefault(); // Không xuống dòng, gửi luôn
              submitComment(e);
            }
          });
        }

        // --- Gửi bình luận không tải lại trang (AJAX) ---
        async function submitComment(e) {
          if (e && e.preventDefault) e.preventDefault();
          const input = document.getElementById('comment-input');
          const btn = document.getElementById('comment-submit-btn');
          if (!input || !btn) return;

          const content = input.value.trim();
          if (!content) return;

          btn.disabled = true;
          const originalBtnHtml = btn.innerHTML;
          btn.innerHTML = `<span class="inline-flex items-center gap-1"><span class="h-2 w-2 rounded-full bg-white animate-bounce" style="animation-delay:0ms"></span><span class="h-2 w-2 rounded-full bg-white animate-bounce" style="animation-delay:150ms"></span><span class="h-2 w-2 rounded-full bg-white animate-bounce" style="animation-delay:300ms"></span> Đang gửi...</span>`;

          try {
            const docId = <%= doc.id %>;
            const resp = await fetch('/docs/' + docId + '/comments', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify({ content })
            });
            const data = await resp.json();
            if (!resp.ok) {
              alert(data.error || 'Không thể gửi bình luận.');
              return;
            }

            input.value = '';
            appendCommentToDOM(data.comment, data.currentUserId, data.currentUserRole);
            updateCommentsCount(1);
          } catch (err) {
            alert('Lỗi kết nối khi gửi bình luận: ' + err.message);
          } finally {
            btn.disabled = false;
            btn.innerHTML = originalBtnHtml;
            input.focus();
          }
        }

        // --- Xóa bình luận không tải lại trang (AJAX) ---
        async function deleteComment(commentId) {
          if (!confirm('Bạn có chắc muốn xóa bình luận này không?')) return;
          try {
            const docId = <%= doc.id %>;
            const resp = await fetch('/docs/' + docId + '/comments/' + commentId + '/delete', {
              method: 'POST',
              headers: {
                'Accept': 'application/json'
              }
            });
            const data = await resp.json();
            if (!resp.ok) {
              alert(data.error || 'Không thể xóa bình luận.');
              return;
            }

            const itemEl = document.getElementById('comment-item-' + commentId);
            if (itemEl) {
              itemEl.style.transition = 'all 0.25s ease';
              itemEl.style.opacity = '0';
              itemEl.style.transform = 'translateY(-8px)';
              setTimeout(() => {
                itemEl.remove();
                updateCommentsCount(-1);
              }, 250);
            }
          } catch (err) {
            alert('Lỗi kết nối khi xóa bình luận: ' + err.message);
          }
        }

        function updateCommentsCount(delta) {
          const badge = document.getElementById('comments-count-badge');
          const title = document.getElementById('comments-count-title');
          let current = parseInt(badge ? badge.textContent : '0', 10) || 0;
          let next = Math.max(0, current + delta);
          if (badge) badge.textContent = next;
          if (title) title.textContent = next;

          const listContainer = document.getElementById('comments-list-container');
          const section = document.getElementById('comments-section');
          if (next === 0 && listContainer) {
            listContainer.innerHTML = `
              <div id="no-comments-placeholder" class="py-10 text-center text-slate-400 dark:text-slate-500">
                <svg class="h-10 w-10 mx-auto mb-2 text-slate-300 dark:text-slate-600" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 12a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H8.25m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0H12m4.125 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm0 0h-.375M21 12c0 4.556-4.03 8.25-9 8.25a9.764 9.764 0 0 1-2.555-.337A5.972 5.972 0 0 1 5.41 21c-.496 0-.89-.408-.89-.91 0-.16.036-.316.104-.457A5.98 5.98 0 0 0 6 16.5c0-.62-.128-1.21-.36-1.748C4.545 13.57 4 12.02 4 10.375 4 5.75 8.03 2 13 2s9 3.75 9 8.375Z" />
                </svg>
                <p class="text-sm">Chưa có bình luận nào cho tài liệu này.</p>
                <p class="text-xs text-slate-400 mt-0.5">Hãy là người đầu tiên để lại ý kiến!</p>
              </div>`;
          }
        }

        function appendCommentToDOM(c, currentUserId, currentUserRole) {
          const placeholder = document.getElementById('no-comments-placeholder');
          if (placeholder) placeholder.remove();

          let list = document.getElementById('comments-list-container');
          if (!list) {
            list = document.createElement('div');
            list.id = 'comments-list-container';
            list.className = 'space-y-4';
            document.getElementById('comments-section').appendChild(list);
          }

          const div = document.createElement('div');
          div.id = 'comment-item-' + c.id;
          div.className = 'flex gap-3.5 p-4 rounded-xl border border-slate-100 dark:border-slate-700/60 bg-slate-50/50 dark:bg-slate-900/40 hover:bg-slate-50 dark:hover:bg-slate-900/70 transition-colors group ai-msg-animate';

          const initial = (c.username || 'U').charAt(0).toUpperCase();
          const roleBadge = c.role === 'admin' ? '<span class="rounded bg-rose-100 dark:bg-rose-950/60 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-rose-600 dark:text-rose-400">Quản trị viên</span>' : '';
          const deptName = c.department_name || c.khoa_name;
          const deptBadge = deptName ? `<span class="rounded bg-slate-200/80 dark:bg-slate-800 px-1.5 py-0.5 text-[10px] font-medium text-slate-600 dark:text-slate-300">${escapeHtml(deptName)}</span>` : '';
          const dateStr = new Date().toLocaleString('vi-VN', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' });

          const canDelete = currentUserRole === 'admin' || currentUserId === c.user_id;
          const deleteBtn = canDelete ? `
            <button type="button" onclick="deleteComment(${c.id})" class="opacity-0 group-hover:opacity-100 transition-opacity p-1 rounded text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/30 transition-colors" title="Xóa bình luận">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="1.75" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
              </svg>
            </button>` : '';

          div.innerHTML = `
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gradient-to-tr from-brand-500 to-indigo-600 text-white font-bold text-xs shadow-sm">
              ${escapeHtml(initial)}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between gap-2">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-sm font-semibold text-slate-800 dark:text-slate-100">${escapeHtml(c.username)}</span>
                  ${roleBadge}
                  ${deptBadge}
                  <span class="text-xs text-slate-400">• ${dateStr}</span>
                </div>
                ${deleteBtn}
              </div>
              <p class="mt-1.5 text-sm text-slate-700 dark:text-slate-300 whitespace-pre-line leading-relaxed">${escapeHtml(c.content)}</p>
            </div>`;

          list.appendChild(div);
        }

        // Khôi phục lịch sử chat của tài liệu khi tải trang
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initDocChatHistory);
        } else {
          initDocChatHistory();
        }

        // Quản lý phiên để hủy bỏ các lệnh đọc trùng lặp
        window.__ttsSessionId = null;

        // --- Hàm Cốt lõi xử lý Đọc Âm Thanh (Backend TTS Liên mạch kèm Tải) ---
        window.speakText = async function (text, btnId = null) {
          if (!text || text.trim() === '') return;

          const currentSession = Date.now();
          window.__ttsSessionId = currentSession;

          if (window.__currentCloudAudio) {
            window.__currentCloudAudio.pause();
            window.__currentCloudAudio = null;
          }
          window.__ttsQueue = [];

          let btnEl = null;
          let originalHtml = '';
          if (btnId) {
            btnEl = document.getElementById(btnId);
            if (btnEl) {
                originalHtml = btnEl.innerHTML;
                btnEl.innerHTML = `<span class="inline-flex gap-1 items-center"><span class="h-2 w-2 rounded-full bg-brand-500 animate-bounce" style="animation-delay:0ms"></span><span class="h-2 w-2 rounded-full bg-brand-500 animate-bounce" style="animation-delay:150ms"></span><span class="h-2 w-2 rounded-full bg-brand-500 animate-bounce" style="animation-delay:300ms"></span> Đang nạp...</span>`;
            }
          }
          
          if (ttsMainBtn && btnId !== 'main') {
              // Hide the global reading button if using internal bubbles
          } else if (btnId === 'main') {
              originalHtml = ttsMainBtn.innerHTML;
              ttsMainBtn.innerHTML = `Đang nạp...`;
          }

          console.log(`Đang tải toàn bộ dữ liệu âm thanh từ Backend...`);

          try {
            const resp = await fetch('/api/ai/tts', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ text })
            });

            if (!resp.ok) throw new Error("Lỗi Server TTS");
            
            const data = await resp.json();
            
            // Nếu người dùng đã spam click khác trong lúc tải xong, hủy luồng này
            if (window.__ttsSessionId !== currentSession) return;
            
            // Xóa hiệu ứng tải
            if (btnEl) btnEl.innerHTML = originalHtml;
            if (btnId === 'main') ttsMainBtn.innerHTML = originalHtml;

            if (data.chunks && data.chunks.length > 0) {
              window.__ttsQueue = data.chunks;
              
              function playNextHandoff() {
                  if (window.__ttsSessionId !== currentSession) return;
                  if (window.__ttsQueue.length === 0) {
                      // Đã phát xong hết
                      if (btnEl) btnEl.classList.remove('opacity-50');
                      return;
                  }
                  if (btnEl) btnEl.classList.add('opacity-50'); // Làm mờ nhẹ khi đang phát

                  const base64Audio = window.__ttsQueue.shift();
                  const audio = new Audio("data:audio/mp3;base64," + base64Audio);
                  window.__currentCloudAudio = audio;
                  // Ngay khi file audio này phát xong thì nối liền file sau luôn không có độ trễ logic server nữa
                  audio.onended = playNextHandoff;
                  audio.onerror = () => { console.log('Chunk error'); playNextHandoff(); };
                  audio.play().catch(e => console.log('Autoplay blocked:', e));
              }
              
              playNextHandoff();
            }
          } catch (err) {
            console.error(err);
            if (btnEl) btnEl.innerHTML = originalHtml;
            if (btnId === 'main') ttsMainBtn.innerHTML = originalHtml;
          }
        }

        // --- Text-to-Speech (Global Page Selection) ---
        const ttsMainBtn = document.createElement('button');
        ttsMainBtn.innerHTML = '<span class="text-sm">🔊</span> Đọc';
        ttsMainBtn.className = 'fixed z-[100] bg-brand-600 hover:bg-brand-500 text-white rounded-md px-2.5 py-1 text-xs font-semibold shadow-xl transition-opacity flex items-center gap-1.5 hidden';
        document.body.appendChild(ttsMainBtn);

        let pageSelectedText = '';
        document.addEventListener('selectionchange', () => {
          const selection = window.getSelection();
          pageSelectedText = selection.toString().trim();
          if (pageSelectedText.length > 0) {
            try {
              const range = selection.getRangeAt(0);
              const rect = range.getBoundingClientRect();
              ttsMainBtn.style.top = (rect.top - 36) + 'px';
              ttsMainBtn.style.left = (rect.left + (rect.width / 2) - 30) + 'px';
              ttsMainBtn.classList.remove('hidden');
            } catch(e) {}
          } else {
            ttsMainBtn.classList.add('hidden');
          }
        });

        ttsMainBtn.addEventListener('mousedown', (e) => {
          e.preventDefault(); // Giữ highlight
          if (pageSelectedText) {
            window.speakText(pageSelectedText, 'main');
          }
        });
      </script>

      <%- include('../partials/footer') %>
<%
var _fn = (typeof fname !== 'undefined' ? fname : '').toLowerCase();
var _isLink = _fn.startsWith('http://') || _fn.startsWith('https://');
var _ext = _fn.split('.').pop();
var _map = {
  pdf:  { bg: '#DC2626', label: 'PDF' },
  doc:  { bg: '#2563EB', label: 'DOC' },
  docx: { bg: '#2563EB', label: 'DOC' },
  xls:  { bg: '#16A34A', label: 'XLS' },
  xlsx: { bg: '#16A34A', label: 'XLS' },
  csv:  { bg: '#16A34A', label: 'CSV' },
  ppt:  { bg: '#EA580C', label: 'PPT' },
  pptx: { bg: '#EA580C', label: 'PPT' },
  txt:  { bg: '#0891B2', label: 'TXT' },
  md:   { bg: '#0891B2', label: 'MD' },
  jpg:  { bg: '#9333EA', label: 'JPG' },
  jpeg: { bg: '#9333EA', label: 'JPG' },
  png:  { bg: '#9333EA', label: 'PNG' },
  webp: { bg: '#9333EA', label: 'WEBP' },
  gif:  { bg: '#9333EA', label: 'GIF' },
  mp4:  { bg: '#E11D48', label: 'VID' },
  webm: { bg: '#E11D48', label: 'VID' },
  mp3:  { bg: '#8B5CF6', label: 'AUD' },
  wav:  { bg: '#8B5CF6', label: 'AUD' },
  m4a:  { bg: '#8B5CF6', label: 'AUD' },
  zip:  { bg: '#CA8A04', label: 'ZIP' },
  rar:  { bg: '#CA8A04', label: 'RAR' }
};
var _info = _isLink ? { bg: '#3B82F6', label: 'LINK' } : (_map[_ext] || { bg: '#64748B', label: _ext ? _ext.toUpperCase().slice(0,4) : 'FILE' });
%>
<div class="flex h-full w-full items-center justify-center bg-slate-100 dark:bg-slate-900/50">
  <div class="flex flex-col items-center gap-1">
    <% if (_isLink) { %>
      <svg class="h-12 w-12 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
      </svg>
    <% } else { %>
      <svg class="h-12 w-12" viewBox="0 0 48 48" fill="none">
        <path d="M12 4h16l12 12v28a2 2 0 0 1-2 2H12a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" fill="<%= _info.bg %>" opacity="0.15"/>
        <path d="M12 4h16l12 12v28a2 2 0 0 1-2 2H12a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z" stroke="<%= _info.bg %>" stroke-width="2" fill="none"/>
        <path d="M28 4v12h12" stroke="<%= _info.bg %>" stroke-width="2" fill="none"/>
      </svg>
    <% } %>
    <span class="rounded px-2 py-0.5 text-xs font-bold text-white" style="background:<%= _info.bg %>"><%= _info.label %></span>
  </div>
</div>

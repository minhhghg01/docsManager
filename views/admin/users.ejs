<%- include('../partials/header') %>
<div class="grid grid-cols-[auto_1fr_auto] items-center gap-3">
  <div class="flex items-center gap-2">
    <a href="/admin/dashboard" class="rounded p-1.5 text-brand-600 transition-all hover:bg-brand-50 hover:text-brand-800" title="Quản trị">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18"/></svg>
    </a>
    <h1 class="text-2xl font-bold text-slate-800 dark:text-white">Tài khoản</h1>
  </div>
  <div class="flex justify-center">
    <%- include('../partials/pagination', { pg, part: 'nav' }) %>
  </div>
  <div class="flex items-center gap-3">
    <%- include('../partials/pagination', { pg, part: 'info' }) %>
  </div>
</div>
<% if (error) { %>
  <p class="mt-3 rounded-md bg-red-50 dark:bg-red-950/50 border border-red-200 dark:border-red-800 px-3 py-2 text-sm text-red-800 dark:text-red-300"><%= error %></p>
<% } %>
<% if (typeof success !== 'undefined' && success) { %>
  <p class="mt-3 rounded-md bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800 px-3 py-2 text-sm text-emerald-800 dark:text-emerald-300"><%= success %></p>
<% } %>
<div class="mt-6 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 p-6 shadow-sm">
  <h2 class="font-semibold text-slate-800 dark:text-white">Tạo tài khoản</h2>
  <form method="post" action="/admin/users" autocomplete="off" class="mt-4 grid gap-4 sm:grid-cols-2">
    <div>
      <label class="block text-sm font-medium text-slate-700 dark:text-slate-300">Username</label>
      <input name="username" required autocomplete="off" class="mt-1 w-full rounded-md border border-slate-300 dark:border-slate-600 bg-transparent dark:text-white px-3 py-2 transition-all focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 dark:text-slate-300">Mật khẩu</label>
      <input type="password" name="password" required autocomplete="new-password" minlength="8" pattern="(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[^a-zA-Z0-9]).{8,}" title="Tối thiểu 8 ký tự: chữ hoa, chữ thường, số, ký tự đặc biệt" class="mt-1 w-full rounded-md border border-slate-300 dark:border-slate-600 bg-transparent dark:text-white px-3 py-2 transition-all focus:border-brand-500 focus:outline-none focus:ring-1 focus:ring-brand-500" />
      <p class="mt-1 text-xs text-slate-400">Tối thiểu 8 ký tự: chữ hoa, chữ thường, số, ký tự đặc biệt</p>
    </div>
    <div>
      <label class="block text-sm font-medium text-slate-700 dark:text-slate-300">Vai trò</label>
      <select name="role" id="roleSel" class="mt-1 w-full rounded-md border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 dark:text-white px-3 py-2 transition-all focus:border-brand-500 focus:ring-1 focus:ring-brand-500">
        <option value="khoa">Người dùng</option>
        <option value="department_head">Trưởng phòng</option>
        <option value="admin">Admin</option>
      </select>
    </div>
    <div id="khoaWrap">
      <label class="block text-sm font-medium text-slate-700 dark:text-slate-300">Khoa/phòng</label>
      <select name="khoa_id" class="mt-1 w-full rounded-md border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 dark:text-white px-3 py-2 transition-all focus:border-brand-500 focus:ring-1 focus:ring-brand-500">
        <option value="">— Chọn —</option>
        <% departments.forEach(function (d) { %>
          <option value="<%= d.id %>"><%= d.name %></option>
        <% }); %>
      </select>
    </div>
    <div class="sm:col-span-2">
      <button type="submit" class="rounded-md bg-brand-600 px-4 py-2 font-semibold text-white transition-all hover:bg-brand-700 hover:shadow-md">Tạo</button>
    </div>
  </form>
</div>
<ul class="mt-8 divide-y divide-slate-200 dark:divide-slate-700 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 shadow-sm">
  <% users.forEach(function (u) { %>
    <li class="p-4 transition-all hover:bg-slate-50 dark:hover:bg-slate-700/50 flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
      <!-- Thông tin user & form sửa vai trò / khoa phòng -->
      <div class="flex flex-col sm:flex-row sm:items-center gap-3 flex-1">
        <div class="min-w-[150px]">
          <div class="flex items-center gap-2">
            <span class="font-semibold text-slate-800 dark:text-slate-100"><%= u.username %></span>
            <% if (u.id === user.id) { %>
              <span class="rounded bg-brand-100 dark:bg-brand-950/60 text-brand-700 dark:text-brand-300 text-[10px] font-bold px-1.5 py-0.5 uppercase tracking-wide">Bạn</span>
            <% } %>
          </div>
          <div class="mt-0.5 text-xs text-slate-500 dark:text-slate-400">
            <%= u.role === 'admin' ? 'Quản trị viên' : (u.role === 'department_head' ? 'Trưởng phòng' : 'Khoa / Nhân viên') %>
            <% if (u.khoa_name) { %> • <%= u.khoa_name %><% } %>
          </div>
        </div>

        <!-- Form sửa vai trò và khoa phòng -->
        <form method="post" action="/admin/users/<%= u.id %>/edit" class="flex flex-wrap items-center gap-2">
          <div>
            <select name="role" class="rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 dark:text-white px-2.5 py-1 text-xs transition-all focus:border-brand-500 focus:ring-1 focus:ring-brand-500">
              <option value="khoa" <%= u.role === 'khoa' ? 'selected' : '' %>>Người dùng</option>
              <option value="department_head" <%= u.role === 'department_head' ? 'selected' : '' %>>Trưởng phòng</option>
              <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Admin</option>
            </select>
          </div>
          <div>
            <select name="khoa_id" class="rounded border border-slate-300 dark:border-slate-600 bg-white dark:bg-slate-800 dark:text-white px-2.5 py-1 text-xs transition-all focus:border-brand-500 focus:ring-1 focus:ring-brand-500 max-w-[190px]">
              <option value="">— Chưa gán khoa —</option>
              <% departments.forEach(function (d) { %>
                <option value="<%= d.id %>" <%= u.khoa_id === d.id ? 'selected' : '' %>><%= d.name %></option>
              <% }); %>
            </select>
          </div>
          <button type="submit" class="inline-flex items-center gap-1 rounded bg-brand-600 px-2.5 py-1 text-xs font-semibold text-white shadow-sm transition-all hover:bg-brand-700 hover:shadow" title="Lưu vai trò và khoa phòng">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
            Lưu
          </button>
        </form>
      </div>

      <!-- Form đổi mật khẩu & xóa tài khoản -->
      <div class="flex items-center gap-2 shrink-0 pt-2 lg:pt-0 border-t lg:border-t-0 border-slate-100 dark:border-slate-700">
        <form method="post" action="/admin/users/<%= u.id %>/password" class="flex items-center gap-1">
          <input type="password" name="password" placeholder="Mật khẩu mới" autocomplete="new-password" minlength="8" class="w-32 sm:w-36 rounded border border-slate-300 dark:border-slate-600 bg-transparent dark:text-white px-2 py-1 text-xs transition-all focus:border-brand-500 focus:ring-1 focus:ring-brand-500" />
          <button type="submit" class="rounded p-1.5 text-slate-500 hover:bg-emerald-50 hover:text-emerald-600 dark:hover:bg-emerald-950/40 dark:hover:text-emerald-400 transition-all" title="Đổi mật khẩu">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/></svg>
          </button>
        </form>
        <% if (u.id !== user.id) { %>
          <form method="post" action="/admin/users/<%= u.id %>/delete" onsubmit="return confirm('Bạn có chắc chắn muốn xóa tài khoản <%= u.username %>?');">
            <button type="submit" class="rounded p-1.5 text-slate-400 hover:bg-red-50 hover:text-red-600 dark:hover:bg-red-950/40 dark:hover:text-red-400 transition-all" title="Xóa">
              <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/></svg>
            </button>
          </form>
        <% } %>
      </div>
    </li>
  <% }); %>
</ul>
<script>
  (function () {
    var sel = document.getElementById('roleSel');
    var wrap = document.getElementById('khoaWrap');
    function sync() {
      wrap.style.display = sel.value === 'admin' ? 'none' : 'block';
    }
    sel.addEventListener('change', sync);
    sync();
  })();
</script>
<%- include('../partials/footer') %>
